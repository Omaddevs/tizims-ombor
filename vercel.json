{
  "installCommand": "npm install --prefix client",
  "buildCommand": "npm run build --prefix client",
  "outputDirectory": "client/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://REPLACE_WITH_BACKEND_URL/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://REPLACE_WITH_BACKEND_URL/uploads/:path*" }
  ]
}
